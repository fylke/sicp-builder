#lang sicp
(#%require rackunit "../lib.rkt")

;; Your exercises/chapter-3/exercise-3.23.rkt must (#%provide make-deque empty-deque?
;;   front-deque rear-deque front-insert-deque! rear-insert-deque!
;;   front-delete-deque! rear-delete-deque!)
;;   (make-deque)                 -> a new empty deque
;;   (empty-deque? d)             -> #t if d has no items
;;   (front-deque d) (rear-deque d) -> the first / last item (error if d is empty)
;;   (front-insert-deque! d item) (rear-insert-deque! d item) -> insert at that end
;;   (front-delete-deque! d) (rear-delete-deque! d) -> remove that end (error if empty)
;; Return values of the mutators are not checked.

(test-case "a new deque is empty"
  (define make-deque (solution "3.23" 'make-deque))
  (define empty-deque? (solution "3.23" 'empty-deque?))
  (check-true (empty-deque? (make-deque))))

(test-case "front inserts put items at the front"
  (define make-deque (solution "3.23" 'make-deque))
  (define empty-deque? (solution "3.23" 'empty-deque?))
  (define front-deque (solution "3.23" 'front-deque))
  (define rear-deque (solution "3.23" 'rear-deque))
  (define front-insert-deque! (solution "3.23" 'front-insert-deque!))
  (define d (make-deque))
  (front-insert-deque! d 1)
  (check-false (empty-deque? d))
  (check-equal? (front-deque d) 1)
  (check-equal? (rear-deque d) 1)
  (front-insert-deque! d 2)
  (front-insert-deque! d 3)
  (check-equal? (front-deque d) 3)
  (check-equal? (rear-deque d) 1))

(test-case "rear inserts put items at the rear"
  (define make-deque (solution "3.23" 'make-deque))
  (define front-deque (solution "3.23" 'front-deque))
  (define rear-deque (solution "3.23" 'rear-deque))
  (define rear-insert-deque! (solution "3.23" 'rear-insert-deque!))
  (define d (make-deque))
  (rear-insert-deque! d 1)
  (rear-insert-deque! d 2)
  (rear-insert-deque! d 3)
  (check-equal? (front-deque d) 1)
  (check-equal? (rear-deque d) 3))

(test-case "front deletes remove in order"
  (define make-deque (solution "3.23" 'make-deque))
  (define empty-deque? (solution "3.23" 'empty-deque?))
  (define front-deque (solution "3.23" 'front-deque))
  (define rear-deque (solution "3.23" 'rear-deque))
  (define rear-insert-deque! (solution "3.23" 'rear-insert-deque!))
  (define front-delete-deque! (solution "3.23" 'front-delete-deque!))
  (define d (make-deque))
  (rear-insert-deque! d 'a)
  (rear-insert-deque! d 'b)
  (rear-insert-deque! d 'c)
  (front-delete-deque! d)
  (check-equal? (front-deque d) 'b)
  (check-equal? (rear-deque d) 'c)
  (front-delete-deque! d)
  (front-delete-deque! d)
  (check-true (empty-deque? d)))

(test-case "rear deletes remove in order"
  (define make-deque (solution "3.23" 'make-deque))
  (define empty-deque? (solution "3.23" 'empty-deque?))
  (define front-deque (solution "3.23" 'front-deque))
  (define rear-deque (solution "3.23" 'rear-deque))
  (define front-insert-deque! (solution "3.23" 'front-insert-deque!))
  (define rear-delete-deque! (solution "3.23" 'rear-delete-deque!))
  (define d (make-deque))
  (front-insert-deque! d 'a)
  (front-insert-deque! d 'b)
  (front-insert-deque! d 'c)
  (rear-delete-deque! d)
  (check-equal? (rear-deque d) 'b)
  (check-equal? (front-deque d) 'c)
  (rear-delete-deque! d)
  (rear-delete-deque! d)
  (check-true (empty-deque? d)))

(test-case "mixed operations (needs a way back from the rear)"
  (define make-deque (solution "3.23" 'make-deque))
  (define empty-deque? (solution "3.23" 'empty-deque?))
  (define front-deque (solution "3.23" 'front-deque))
  (define rear-deque (solution "3.23" 'rear-deque))
  (define front-insert-deque! (solution "3.23" 'front-insert-deque!))
  (define rear-insert-deque! (solution "3.23" 'rear-insert-deque!))
  (define front-delete-deque! (solution "3.23" 'front-delete-deque!))
  (define rear-delete-deque! (solution "3.23" 'rear-delete-deque!))
  (define d (make-deque))
  (rear-insert-deque! d 2)
  (rear-insert-deque! d 3)
  (rear-insert-deque! d 4)
  (front-insert-deque! d 1)
  ;; 1 2 3 4
  (rear-delete-deque! d)
  (check-equal? (rear-deque d) 3)
  (rear-delete-deque! d)
  (check-equal? (rear-deque d) 2)
  (front-delete-deque! d)
  (check-equal? (front-deque d) 2)
  (check-equal? (rear-deque d) 2)
  (rear-delete-deque! d)
  (check-true (empty-deque? d))
  (front-insert-deque! d 'x)
  (rear-insert-deque! d 'y)
  (check-equal? (front-deque d) 'x)
  (check-equal? (rear-deque d) 'y))

(test-case "a larger deque used from both ends"
  (define make-deque (solution "3.23" 'make-deque))
  (define empty-deque? (solution "3.23" 'empty-deque?))
  (define front-deque (solution "3.23" 'front-deque))
  (define rear-deque (solution "3.23" 'rear-deque))
  (define front-insert-deque! (solution "3.23" 'front-insert-deque!))
  (define rear-insert-deque! (solution "3.23" 'rear-insert-deque!))
  (define front-delete-deque! (solution "3.23" 'front-delete-deque!))
  (define rear-delete-deque! (solution "3.23" 'rear-delete-deque!))
  (define d (make-deque))
  (define (fill i)
    (if (< i 1000)
        (begin (rear-insert-deque! d i) (fill (+ i 1)))))
  (fill 0)
  (define (drain i)
    (if (< i 500)
        (begin
          (check-equal? (front-deque d) i)
          (check-equal? (rear-deque d) (- 999 i))
          (front-delete-deque! d)
          (rear-delete-deque! d)
          (drain (+ i 1)))))
  (drain 0)
  (check-true (empty-deque? d)))

(test-case "front/rear access and deletes on an empty deque are errors"
  (define make-deque (solution "3.23" 'make-deque))
  (define front-deque (solution "3.23" 'front-deque))
  (define rear-deque (solution "3.23" 'rear-deque))
  (define front-delete-deque! (solution "3.23" 'front-delete-deque!))
  (define rear-delete-deque! (solution "3.23" 'rear-delete-deque!))
  (check-exn (lambda (e) #t) (lambda () (front-deque (make-deque))))
  (check-exn (lambda (e) #t) (lambda () (rear-deque (make-deque))))
  (check-exn (lambda (e) #t) (lambda () (front-delete-deque! (make-deque))))
  (check-exn (lambda (e) #t) (lambda () (rear-delete-deque! (make-deque)))))
