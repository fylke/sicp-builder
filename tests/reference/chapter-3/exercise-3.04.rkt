#lang sicp
(#%provide make-account call-the-cops cops-called)

(define cops 0)
(define (call-the-cops) (set! cops (+ cops 1)) "Cops called")
(define (cops-called) cops)

(define (make-account balance password)
  (let ((bad-count 0))
    (define (withdraw amount)
      (if (>= balance amount)
          (begin (set! balance (- balance amount))
                 balance)
          "Insufficient funds"))
    (define (deposit amount)
      (set! balance (+ balance amount))
      balance)
    (define (bad-password amount)
      (set! bad-count (+ bad-count 1))
      (if (> bad-count 7)
          (call-the-cops)
          "Incorrect password"))
    (define (dispatch p m)
      (cond ((not (eq? p password)) bad-password)
            (else
             (set! bad-count 0)
             (cond ((eq? m 'withdraw) withdraw)
                   ((eq? m 'deposit) deposit)
                   (else (error "Unknown request: MAKE-ACCOUNT" m))))))
    dispatch))
