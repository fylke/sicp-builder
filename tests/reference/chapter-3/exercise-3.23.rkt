#lang sicp
(#%provide make-deque empty-deque? front-deque rear-deque
           front-insert-deque! rear-insert-deque!
           front-delete-deque! rear-delete-deque!)

;; node: (item . (prev . next)); deque: (front-ptr . rear-ptr)
(define (make-node item) (cons item (cons '() '())))
(define (node-item n) (car n))
(define (node-prev n) (cadr n))
(define (node-next n) (cddr n))
(define (set-node-prev! n p) (set-car! (cdr n) p))
(define (set-node-next! n p) (set-cdr! (cdr n) p))

(define (make-deque) (cons '() '()))
(define (front-ptr d) (car d))
(define (rear-ptr d) (cdr d))
(define (empty-deque? d) (null? (front-ptr d)))

(define (front-deque d)
  (if (empty-deque? d)
      (error "FRONT-DEQUE called with an empty deque")
      (node-item (front-ptr d))))

(define (rear-deque d)
  (if (empty-deque? d)
      (error "REAR-DEQUE called with an empty deque")
      (node-item (rear-ptr d))))

(define (front-insert-deque! d item)
  (let ((n (make-node item)))
    (if (empty-deque? d)
        (begin (set-car! d n) (set-cdr! d n))
        (begin (set-node-next! n (front-ptr d))
               (set-node-prev! (front-ptr d) n)
               (set-car! d n)))
    d))

(define (rear-insert-deque! d item)
  (let ((n (make-node item)))
    (if (empty-deque? d)
        (begin (set-car! d n) (set-cdr! d n))
        (begin (set-node-prev! n (rear-ptr d))
               (set-node-next! (rear-ptr d) n)
               (set-cdr! d n)))
    d))

(define (front-delete-deque! d)
  (if (empty-deque? d)
      (error "FRONT-DELETE-DEQUE! called with an empty deque")
      (let ((next (node-next (front-ptr d))))
        (set-car! d next)
        (if (null? next)
            (set-cdr! d '())
            (set-node-prev! next '()))
        d)))

(define (rear-delete-deque! d)
  (if (empty-deque? d)
      (error "REAR-DELETE-DEQUE! called with an empty deque")
      (let ((prev (node-prev (rear-ptr d))))
        (set-cdr! d prev)
        (if (null? prev)
            (set-car! d '())
            (set-node-next! prev '()))
        d)))
