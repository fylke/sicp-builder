 $VERSION = '6.0';
 
+# I/O commands                            # (A.R) -->
+
+# Return contents of file as string
+sub swallow {
+  my $filename = shift;
+  local $/;
+  open my $fh, "<", $filename;
+  return <$fh>;
+}
+
+# Write contents of string to file
+sub pour {
+  my ($string, $filename) = @_;
+  open my $fh, ">", $filename;
+  print $fh $string;
+  close $fh;
+}                                         # --> (A.R)
+
 # misc commands that are of use for formatting.
